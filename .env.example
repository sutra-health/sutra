# Core
PORT=4100
PUBLIC_BASE_URL=https://sutra.hospital.example
DATABASE_URL=postgres://sutra:sutra-dev-password@postgres:5432/sutra
POSTGRES_PASSWORD=replace-with-a-secret
OBJECT_STORAGE_PATH=/var/lib/sutra/evidence
SUTRA_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-secret

# Authentication: WorkOS is recommended; Keycloak can supply the same OIDC values.
# Use demo only for local synthetic-data development.
AUTH_MODE=demo
AUTH_PROVIDER=workos
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
OIDC_ISSUER=https://api.workos.com/
OIDC_JWKS_URL=https://api.workos.com/sso/jwks/replace-with-workos-client-id
OIDC_AUDIENCE=sutra-api

# Expo / React Native Web. Fixtures are available only when this is exactly true.
# Keep API_URL empty behind the bundled nginx reverse proxy so API calls are same-origin.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_OIDC_PROVIDER=workos
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_WORKOS_ISSUER=https://api.workos.com/user_management
# Keycloak alternative:
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://identity.hospital.example/realms/sutra

# Connector selection. Set either side to grpc for a hospital/vendor adapter.
CLINICAL_ADAPTER=openmrs
SCHEDULER_ADAPTER=openmrs
ADAPTER_GRPC_ADDRESS=

# Reference OpenMRS Mini adapter (inside the hospital boundary)
OPENMRS_BASE_URL=https://openmrs.hospital.example/openmrs
OPENMRS_USERNAME=sutra-service
OPENMRS_PASSWORD=replace-me

# Real WhatsApp: Meta webhooks terminate at Chatwoot. Chatwoot sends signed events to SUTRA.
CHATWOOT_BASE_URL=https://chatwoot.hospital.example
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# TypeSafe Jev. Use synthetic/de-identified text until hospital privacy approval.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.85
JEV_DATA_MODE=synthetic

# Local inference
OCR_SERVICE_URL=http://ocr:8001
OCR_MODEL_ID=PaddlePaddle/PaddleOCR-VL-1.6
OCR_PIPELINE_VERSION=v1.6
OCR_DEVICE=cpu
STT_SERVICE_URL=http://stt:8002
INDIC_CONFORMER_MODEL_PATH=/models/indicconformer.nemo

# ABDM bridge. The bridge owns ABDM credentials; SUTRA stores only references/provenance.
ABDM_BRIDGE_URL=http://abdm-bridge:8080
ABDM_MODE=sandbox
