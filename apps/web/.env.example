# Fixtures are never enabled unless this is exactly true.
EXPO_PUBLIC_DEMO_MODE=false

# Blank uses the same origin on web (recommended behind the nginx /api proxy).
# Native builds need the hospital-reachable API origin, for example:
EXPO_PUBLIC_API_URL=

# OIDC/AuthKit configuration. WorkOS is the default provider abstraction.
EXPO_PUBLIC_OIDC_PROVIDER=workos
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_WORKOS_ISSUER=

# Keycloak alternative:
# EXPO_PUBLIC_OIDC_PROVIDER=keycloak
# EXPO_PUBLIC_KEYCLOAK_ISSUER=https://identity.hospital.example/realms/sutra
